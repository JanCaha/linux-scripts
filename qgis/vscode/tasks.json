{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build QGIS for Testing",
            "detail": "Build QGIS in debug mode with tests using workflow build-for-testing",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--workflow",
                "build-for-testing"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Run QGIS Test for Current C++ File",
            "detail": "Run the test corresponding to the current C++ test file",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/run_test.sh",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/build/output/python:${workspaceFolder}/build/output/python/plugins:${workspaceFolder}/tests/src/python",
                    "LD_LIBRARY_PATH": "${workspaceFolder}/build/output/lib:${env:LD_LIBRARY_PATH}",
                    "QGIS_PREFIX_PATH": "${workspaceFolder}/build/output",
                    "QT_QPA_PLATFORM": "offscreen",
                    "QGIS_DEBUG": "1"
                }
            },
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "QGIS: PostgreSQL Tests Setup",
            "detail": "Run the setup script for PostgreSQL tests for QGIS",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/qgis_postgresql_tests_setup.sh",
            "group": "none",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "QGIS Release build Install with /Opt Libraries",
            "detail": "Build QGIS in release mode without tests and install it with sudo",
            "type": "shell",
            "command": "sudo",
            "args": [
                "cmake",
                "--workflow",
                "release_opt_no_tests_install"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Run PyQGIS Test with Wait for Debugger",
            "type": "shell",
            "isBackground": true,
            "command": "/usr/bin/python3",
            "args": [
                "${workspaceFolder}/.vscode/run_pyqgis_test_debug.py",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/build/output/python:${workspaceFolder}/build/output/python/plugins:${workspaceFolder}/tests/src/python",
                    "LD_LIBRARY_PATH": "${workspaceFolder}/build/output/lib:${env:LD_LIBRARY_PATH}",
                    "QGIS_PREFIX_PATH": "${workspaceFolder}/build/output",
                    "QT_QPA_PLATFORM": "offscreen",
                    "QGIS_DEBUG": "1"
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^__NEVER_MATCHES__$",
                    "endsPattern": "^WAITING_FOR_DEBUGGER$"
                }
            }
        }
    ]
}