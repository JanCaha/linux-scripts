{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch QGIS",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-qt/output/bin/qgis",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build-qt",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/output/lib:${env:LD_LIBRARY_PATH}"
                },
                {
                    "name": "QGIS_PREFIX_PATH",
                    "value": "${workspaceFolder}/build-qt/output"
                },
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/build-qt/output/share/qgis/python:${env:PYTHONPATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "showDisplayString": true,
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug PyQGIS Test (C++)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/python3",
            "args": [
                "${file}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/build/output/python:${workspaceFolder}/build/output/python/plugins:${workspaceFolder}/tests/src/python"
                },
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/output/lib:${env:LD_LIBRARY_PATH}"
                },
                {
                    "name": "QGIS_PREFIX_PATH",
                    "value": "${workspaceFolder}/build/output"
                },
                {
                    "name": "QT_QPA_PLATFORM",
                    "value": "offscreen"
                },
                {
                    "name": "QGIS_DEBUG",
                    "value": "1"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug PyQGIS Test (Python)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "preLaunchTask": "Run PyQGIS Test with Wait for Debugger"
        }
    ]
}