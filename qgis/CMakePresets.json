{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23
    },
    "configurePresets": [
        {
            "name": "configure_base",
            "description": "Base configure QGIS tests disabled",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "environment": {
                "CC": "/usr/bin/gcc",
                "CXX": "/usr/bin/g++"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTS": "OFF",
                "WITH_PDAL": "OFF",
                "WITH_3D": "TRUE",
                "WITH_INTERNAL_SPATIALINDEX": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "configure_with_opt_gdal_pdal_tests",
            "description": "Configure QGIS with /OPT GDAL, PDAL, tests enabled",
            "inherits": [
                "configure_base"
            ],
            "cacheVariables": {
                "ENABLE_TESTS": "ON",
                "CMAKE_PREFIX_PATH": "/opt/pdal;/opt/gdal",
                "WITH_PDAL": "ON",
                "GDAL_DIR": "/opt/gdal/lib/cmake/gdal",
                "GDAL_ROOT": "/opt/gdal"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build_app",
            "description": "Build QGIS application targets only (tests configured but not compiled)",
            "configurePreset": "configure_with_opt_gdal_pdal_tests",
            "jobs": 16,
            "targets": [
                "src/all",
                "python/all",
                "resources/all",
                "images/all",
                "i18n/all"
            ],
            "hidden": false
        },
        {
            "name": "build_tests",
            "description": "Compile QGIS tests (on demand)",
            "configurePreset": "configure_with_opt_gdal_pdal_tests",
            "jobs": 16,
            "targets": [
                "tests/all"
            ],
            "hidden": false
        }
    ],
    "workflowPresets": [
        {
            "name": "build-for-testing",
            "description": "Build QGIS with GDAL and PDAL, tests configured but not compiled",
            "displayName": "Build for Testing",
            "steps": [
                {
                    "type": "configure",
                    "name": "configure_with_opt_gdal_pdal_tests"
                },
                {
                    "type": "build",
                    "name": "build_app"
                }
            ]
        }
    ]
}